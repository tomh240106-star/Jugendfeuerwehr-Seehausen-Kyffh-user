<!-- AndroidManifest.xml: Root-Element muss xmlns:tools enthalten:
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
-->

<!-- Direkt unter <manifest>: -->
<uses-permission android:name="android.permission.WAKE_LOCK" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

<!-- Innerhalb von <application>: -->

<!-- Die vom FlutterFire-Plugin eingetragene Service-Definition ersetzen,
     damit der native Alarm vor Flutter abgefangen werden kann. -->
<service
    android:name="io.flutter.plugins.firebase.messaging.FlutterFirebaseMessagingService"
    tools:node="remove" />

<service
    android:name=".JfFirebaseMessagingService"
    android:exported="false">
    <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
    </intent-filter>
</service>

<service
    android:name=".AlarmForegroundService"
    android:exported="false"
    android:foregroundServiceType="mediaPlayback"
    android:stopWithTask="false" />
